{
  "name": "rs-digital-agency-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "fastify": "^5.2.0", "zod": "^3.24.0" },
  "devDependencies": { "@types/node": "^22.13.0", "tsx": "^4.19.0", "typescript": "^5.7.0", "vitest": "^3.0.0" }
}
